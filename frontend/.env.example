# Local dev: proxy /api → backend (see vite.config.ts)
VITE_API_BASE=/api
VITE_PUBLIC_APP_URL=http://localhost:5173

# Production (Vercel): set these in Project → Settings → Environment Variables
# VITE_API_BASE=https://YOUR-SERVICE.onrender.com
# VITE_PUBLIC_APP_URL=https://YOUR-PROJECT.vercel.app

VITE_TMDB_API_KEY=
VITE_TMDB_READ_TOKEN=
